    }

    private static string LocalTime(DateTime? value)
    {
        if (value is null)
        {
            return "вЂ”";
        }

        return DateTime.SpecifyKind(value.Value, DateTimeKind.Utc)
            .ToLocalTime()
            .ToString("dd.MM.yyyy HH:mm");
    }

    private static string Metric(Node node, double value)
    {
        return node.IsOnline ? $"{value:0.##} %" : "вЂ”";
    }

    private long Traffic24Hours(Node node)
    {
