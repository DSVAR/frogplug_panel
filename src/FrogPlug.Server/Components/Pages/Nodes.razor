    private sealed class NodeForm
    {
        public string Name { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string Country { get; set; } = "RU";
        public string? Domain { get; set; }
        public bool RealityEnabled { get; set; } = true;
        public MaskMode MaskMode { get; set; } = MaskMode.OwnDomain;
        public string? RealitySni { get; set; }
        public string RealityFingerprint { get; set; } = "chrome";
        public string XhttpMode { get; set; } = "auto";
        public bool HysteriaObfsEnabled { get; set; } = true;
        public string? MtprotoHost { get; set; }
        public string StubTemplate { get; set; } = StubSiteTemplates.PersonalBlog;
        public string? StubTitle { get; set; }
        public string XhttpPath { get; set; } = string.Empty;
        public bool XhttpEnabled { get; set; } = true;
        public bool MtprotoEnabled { get; set; }
        public bool TgWebEnabled { get; set; }
        public bool HysteriaEnabled { get; set; }
        public int HysteriaPort { get; set; } = NodePorts.Hysteria;
        public string? Notes { get; set; }
        public bool Entry { get; set; }
        public bool Exit { get; set; }
        public bool RuExit { get; set; }
        public bool GoogleExit { get; set; }
        public bool WhitelistEntry { get; set; }
        public int? WhitelistExitNodeId { get; set; }

        public NodeInput ToInput()
        {
            var role = (Entry ? NodeRole.Entry : 0)
                | (Exit ? NodeRole.Exit : 0)
                | (RuExit ? NodeRole.RuExit : 0)
                | (GoogleExit ? NodeRole.GoogleExit : 0);
            if (WhitelistEntry)
            {
                role |= NodeRole.Entry | NodeRole.WhitelistEntry;
            }
            return new NodeInput(
                Name,
                Address,
                Country,
                role,
                Domain,
                true,
                NodePorts.Reality,
                NodePorts.Xhttp,
                null,
                null,
                null,
                Notes,
                string.Empty,
                string.Empty,
                RealityEnabled,
                XhttpEnabled,
                MaskMode,
                RealitySni,
                MtprotoHost,
                StubTemplate,
                StubTitle,
                WhitelistExitNodeId,
                TgWebEnabled,
                HysteriaEnabled,
                HysteriaPort,
                RealityFingerprint,
                XhttpMode,
                HysteriaObfsEnabled,
                XhttpPath);
        }

        public static NodeForm From(Node node)
        {
            return new NodeForm
            {
                Name = node.Name,
                Address = node.Address,
                Country = node.Country,
                Domain = node.Domain,
                RealityEnabled = node.RealityEnabled,
                MaskMode = node.MaskMode,
                RealitySni = node.RealitySni,
                RealityFingerprint = node.RealityFingerprint,
                XhttpMode = node.XhttpMode,
                HysteriaObfsEnabled = node.HysteriaObfsEnabled,
                MtprotoHost = node.MtprotoHost,
                StubTemplate = node.StubTemplate,
                StubTitle = node.StubTitle,
                XhttpPath = node.XhttpPath,
                XhttpEnabled = node.XhttpEnabled,
                MtprotoEnabled = node.MtprotoEnabled,
                TgWebEnabled = node.TgWebEnabled,
                HysteriaEnabled = node.HysteriaEnabled,
                HysteriaPort = node.HysteriaPort,
                Notes = node.Notes,
                Entry = node.Role.HasFlag(NodeRole.Entry),
                Exit = node.Role.HasFlag(NodeRole.Exit),
                RuExit = node.Role.HasFlag(NodeRole.RuExit),
                GoogleExit = node.Role.HasFlag(NodeRole.GoogleExit),
                WhitelistEntry = node.Role.HasFlag(NodeRole.WhitelistEntry),
                WhitelistExitNodeId = node.WhitelistExitNodeId
            };
        }
    }

    // Тот же критерий, что у Node.MtprotoRouteHost: свой хост, не совпадающий с доменом ноды.
    private bool HasMtprotoRouteHost =>
        !string.IsNullOrWhiteSpace(Form.MtprotoHost) &&
        !string.Equals(Form.MtprotoHost.Trim(), Form.Domain?.Trim(), StringComparison.OrdinalIgnoreCase);
