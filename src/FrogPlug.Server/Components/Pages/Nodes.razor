    }

    private static IEnumerable<(string Label, string Class)> RoleBadges(NodeRole role)
    {
        if (role.HasFlag(NodeRole.Entry))
        {
            yield return ("Вход", "r-in");
        }

        if (role.HasFlag(NodeRole.Exit))
        {
            yield return ("Выход", "r-out");
        }

        if (role.HasFlag(NodeRole.RuExit))
        {
            yield return ("RU-выход", "r-ru");
        }

        if (role.HasFlag(NodeRole.GoogleExit))
        {
            yield return ("Google-выход", "r-g");
        }

        if (role.HasFlag(NodeRole.WhitelistEntry))
        {
            yield return ("Вход для белых списков", "r-in");
        }
    }

    private static string FormatFingerprint(string fingerprint)
    {
        return string.Join(" ", Enumerable.Range(0, fingerprint.Length / 4)
            .Select(index => fingerprint.Substring(index * 4, 4)));
    }

    private static string Roles(NodeRole role)
    {
        return string.Join(", ", Enum.GetValues<NodeRole>()
            .Where(item => role.HasFlag(item))
            .Select(item => item switch
            {
                NodeRole.Entry => "Вход",
                NodeRole.Exit => "Выход",
                NodeRole.RuExit => "RU-выход",
                NodeRole.GoogleExit => "Google-выход",
                NodeRole.WhitelistEntry => "Вход для белых списков",
                _ => string.Empty
            }));
    }

