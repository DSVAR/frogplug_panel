        {
            return "Подключена";
        }

        return "Не подключена";
    }

    private string StateClass(Node node)
    {
        if (Tunnels.IsConnected(node.Id))
        {
            return "status-active";
        }

        return "status-expired";
    }

    private string? LastSeenTitle(Node node)
    {
