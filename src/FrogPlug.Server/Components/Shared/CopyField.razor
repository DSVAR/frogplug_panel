<div class="copy-field">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@InputId">@Label</label>
    }
    <div class="copy-field-controls">
        <input id="@InputId" class="form-control" readonly value="@Value" aria-label="Значение для копирования" />
        <button class="secondary-button" type="button" data-copy-target="@InputId">Копировать</button>
    </div>
</div>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Value { get; set; }

    private string InputId { get; } = $"copy-field-{Guid.NewGuid():N}";
}
